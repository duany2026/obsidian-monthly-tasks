# ============================================
# obsidian-monthly-tasks .gitignore
# ============================================

# 构建输出（由 esbuild 生成，sourcemap 不需要追踪）
*.js.map

# 依赖目录
node_modules/

# Obsidian 插件数据（用户本地配置，不应纳入版本管理）
data.json

# 编辑器配置
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志文件
*.log
npm-debug.log*

# 工作区临时文件
.workbuddy/

# 打包分发产物
*.zip
*.tar.gz

# Obsidian 本地数据
.data/
